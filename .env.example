# Optional local port overrides. Values shown are non-secret development defaults.
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
GATEWAY_PORT=8080
FRONTEND_PORT=3000
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
LOKI_PORT=3100
JAEGER_PORT=16686
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000

# Optional JWT signing configuration for auth-service. When omitted locally, an
# ephemeral RSA key is generated at startup and tokens are invalidated on restart.
# Production-like runs should set both resource locations and disable ephemeral keys.
JWT_PRIVATE_KEY_LOCATION=
JWT_PUBLIC_KEY_LOCATION=
JWT_ALLOW_EPHEMERAL_KEY=true
JWT_ISSUER=urn:event-platform:auth
JWT_AUDIENCE=event-platform-api
JWT_ACCESS_TOKEN_TTL=10m
JWT_REFRESH_TOKEN_TTL=30d
AUTH_BCRYPT_STRENGTH=12

# OAuth2 remains disabled unless real provider credentials and Spring client
# registration properties are supplied privately.
OAUTH2_ENABLED=false

# Optional one-time operational provisioning for the first ADMIN. Leave disabled
# unless both private values are supplied; self-registration never accepts roles.
AUTH_BOOTSTRAP_ADMIN_ENABLED=false
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# Redis-backed gateway rate policies. Disabling is intended only for isolated tests.
GATEWAY_RATE_LIMIT_ENABLED=true
REGISTRATION_RATE_REPLENISH=1
REGISTRATION_RATE_BURST=5
LOGIN_RATE_REPLENISH=1
LOGIN_RATE_BURST=10
REFRESH_RATE_REPLENISH=1
REFRESH_RATE_BURST=10

# Phase 3 event inventory, venue validation, public discovery cache, and outbox.
INVENTORY_HOLD_TTL=15m
PUBLIC_EVENT_CACHE_TTL=5m
EVENT_OUTBOX_ENABLED=true
EVENT_LIFECYCLE_TOPIC=event-platform.event-lifecycle.v1

# Phase 4 attendee booking, ticket signing, and attendee-owned lifecycle outbox.
# Leave the secret empty only for local ephemeral-key development. Persistent
# environments must inject at least 32 random bytes privately and disable fallback.
TICKET_QR_SIGNING_SECRET=
TICKET_QR_ALLOW_EPHEMERAL_KEY=true
ATTENDEE_OUTBOX_ENABLED=true
ATTENDEE_LIFECYCLE_TOPIC=event-platform.attendee-lifecycle.v1
ATTENDEE_EVENT_CONSUMER_ENABLED=true
ATTENDEE_HOLD_EXPIRY_INTERVAL=30s

# Phase 5 provider-neutral payments, signed sandbox webhooks, refunds, and Saga recovery.
PAYMENT_PROVIDER=fake
PAYMENT_WEBHOOK_SECRET=local-fake-webhook-secret-change-me
PAYMENT_EVENTS_TOPIC=event-platform.payment-lifecycle.v1
PAYMENT_PROCESSING_TIMEOUT=30s
PAYMENT_RECONCILIATION_DELAY=10s
BOOKING_SAGA_RECOVERY_INTERVAL=5s

# Replace these only in a private .env file. Never reuse them outside local development.
POSTGRES_ADMIN_PASSWORD=local_dev_only
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local_dev_only
